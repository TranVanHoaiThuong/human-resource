{
  "name": "human-resource",
  "version": "1.0.0",
  "scripts": {
    "build-js": "node build.js",
    "build-js:dev": "node build.js --dev",
    "watch-js": "node watch.js",
    "build-sass": "sass resources/scss/app.scss public/css/app.min.css --style=compressed --source-map",
    "watch-sass": "sass resources/scss/app.scss public/css/app.min.css --style=compressed --source-map --watch",
    "build-tailwind": "tailwindcss -i resources/css/tailwind.css -o public/css/tailwind.min.css --minify",
    "watch-tailwind": "tailwindcss -i resources/css/tailwind.css -o public/css/tailwind.min.css --minify --watch",
    "build": "npm run build-tailwind && npm run build-js && npm run build-sass",
    "build:dev": "npm run build-tailwind && npm run build-js:dev && npm run build-sass"
  },
  "keywords": [],
  "author": "thuongtran",
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "chokidar": "^5.0.0",
    "esbuild": "^0.27.0",
    "glob": "^13.0.0",
    "sass": "^1.94.2",
    "tailwindcss": "^3.4.18"
  }
}
